# =====================================================
# Task Manager Backend - Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git - it contains sensitive data!
# =====================================================

# =====================================================
# DATABASE CONFIGURATION (Supabase PostgreSQL)
# =====================================================

# Connection pooler URL (port 6543) - for application queries
# prepareThreshold=0 disables server-prepared statements for PgBouncer compatibility
# Format: jdbc:postgresql://<region>.pooler.supabase.com:6543/postgres?prepareThreshold=0
DATABASE_URL=jdbc:postgresql://aws-0-us-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&preferQueryMode=simple

# Direct connection URL (port 5432) - for Flyway migrations (OPTIONAL)
# IMPORTANT: Use db.<project-ref>.supabase.co for direct connections, NOT pooler.supabase.com
# If not set, Flyway will use DATABASE_URL (works with prepareThreshold=0)
# Only set this if you have issues with migrations through the pooler
# Format: jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
# FLYWAY_URL=jdbc:postgresql://db.xxxxxxxxxxxxxx.supabase.co:5432/postgres

# Database credentials
# For Supabase, username format is: postgres.<project-ref>
DATABASE_USERNAME=postgres.xxxxxxxxxxxxxx
DATABASE_PASSWORD=your-secure-password-here

# =====================================================
# JWT CONFIGURATION
# =====================================================

# Secret key for JWT token signing
# MUST be at least 32 characters for HS256 algorithm
# Generate a secure random string: openssl rand -base64 64
JWT_SECRET=your-secure-jwt-secret-key-minimum-32-characters-long-base64-encoded

# Token expiration time in milliseconds
# 86400000 = 24 hours
# 604800000 = 7 days
JWT_EXPIRATION_MS=86400000

# =====================================================
# APPLICATION CONFIGURATION
# =====================================================

# Spring profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# Server port
PORT=8080

# =====================================================
# SUPABASE API CONFIGURATION (Optional - for future use)
# =====================================================

# Supabase project URL
SUPABASE_URL=https://xxxxxxxxxxxxxx.supabase.co

# Supabase anon key (public - safe to expose)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =====================================================
# CORS CONFIGURATION (Optional - for production)
# =====================================================

# Comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# =====================================================
# HOW TO GET THESE VALUES
# =====================================================
#
# DATABASE CREDENTIALS (Supabase):
# 1. Go to https://supabase.com/dashboard
# 2. Select your project
# 3. Go to Settings > Database
# 4. Find "Connection string" section
# 5. Use "Transaction pooler" (port 6543) for DATABASE_URL
#    - Add ?prepareThreshold=0&preferQueryMode=simple to the URL
# 6. For FLYWAY_URL (optional): Use "Direct connection" with db.<ref>.supabase.co:5432
#    - Note: pooler.supabase.com does NOT work on port 5432!
# 7. DATABASE_USERNAME format: postgres.<project-ref>
# 8. Password is shown when you created the project (or reset it in Settings > Database)
#
# JWT_SECRET:
# Generate a secure random secret:
#   openssl rand -base64 64
# Or use an online generator (make sure it's at least 32 chars)
#
# SUPABASE_URL and ANON_KEY:
# 1. Go to Settings > API
# 2. Find "Project URL" and "Project API keys"
# 3. Use the "anon" key (public key)
#
# =====================================================
# QUICK START
# =====================================================
#
# 1. Copy this file:
#    cp .env.example .env
#
# 2. Fill in your Supabase credentials
#
# 3. Generate and set JWT_SECRET:
#    openssl rand -base64 64
#
# 4. Save the file
#
# 5. Start the application:
#    mvn spring-boot:run
#
# =====================================================
